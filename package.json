{
  "name": "xueya-copilot",
  "version": "2.0.0",
  "private": true,
  "description": "A redesigned course learning space with grounded answers, notes, practice and planning.",
  "scripts": {
    "start": "python -m backend.server",
    "test": "python -m pytest",
    "test:browser": "python -m scripts.check_browser",
    "mcp:server": "python -m backend.mcp.course_server",
    "mcp:check": "python -m scripts.check_mcp",
    "test:platform-browser": "python -m scripts.check_platform_browser",
    "doctor": "python -m backend.platform.cli doctor",
    "init": "python -m backend.platform.cli init",
    "stop": "python -m backend.platform.cli stop",
    "backup": "python -m backend.platform.cli backup",
    "restore": "python -m backend.platform.cli restore",
    "export": "python -m backend.platform.cli export",
    "gc": "python -m backend.platform.cli gc"
  }
}
