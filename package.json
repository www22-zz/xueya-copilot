{
  "name": "xueya-copilot",
  "version": "2.0.0",
  "private": true,
  "description": "A redesigned course learning space with grounded answers, notes, practice and planning.",
  "scripts": {
    "start": "node scripts/run-python.js -m backend.xueya.server",
    "test": "node scripts/test.js",
    "test:python": "node scripts/run-python.js -m pytest -q",
    "test:frontend": "node scripts/test.js --frontend",
    "test:browser": "node tests/e2e/browser.js",
    "mcp:server": "node scripts/run-python.js -m backend.xueya.mcp_server",
    "mcp:check": "node scripts/run-python.js -m backend.xueya.mcp_server --check",
    "doctor": "node scripts/run-python.js -m backend.xueya.cli doctor",
    "init": "node scripts/run-python.js -m backend.xueya.cli init",
    "backup": "node scripts/run-python.js -m backend.xueya.cli backup",
    "restore": "node scripts/run-python.js -m backend.xueya.cli restore",
    "export": "node scripts/run-python.js -m backend.xueya.cli export",
    "stop": "node scripts/run-python.js -m backend.xueya.cli stop",
    "test:workspace": "node tests/e2e/workspace.js",
    "test:platform": "node tests/e2e/platform.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {}
}
