MIMO_API_KEY=replace_with_your_key
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.6-flash
MCP_TOOL_TIMEOUT_MS=5000
XUEYA_DATA_DIR=.xueya-data
API_MAX_CONCURRENT=2

# Optional external RAG services. Keep keys/model blank until configured.
# Embedding dimension must match the selected provider model.
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_MODEL=
RAG_EMBEDDING_BASE_URL=https://api.jina.ai/v1
RAG_EMBEDDING_DIMENSION=1024
RAG_EMBEDDING_REVISION=1
RAG_RERANK_API_KEY=
RAG_RERANK_MODEL=
RAG_RERANK_BASE_URL=https://api.jina.ai/v1
RAG_OCR_API_KEY=
RAG_OCR_MODEL=
RAG_OCR_BASE_URL=https://api.mistral.ai/v1
