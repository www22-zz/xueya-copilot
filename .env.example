MIMO_API_KEY=replace_with_your_key
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.6-flash
MCP_TOOL_TIMEOUT_MS=5000
XUEYA_DATA_DIR=.xueya-data
# Legacy 17-deck import stays off; the single-file portable bundle is enabled below.
XUEYA_AUTO_IMPORT_DEMO=0
# Preserve private historical learning records during a materials-only update.
# Also keeps retired workspace fields when the current UI saves its projection.
XUEYA_PRESERVE_LEGACY_DATA=0
API_MAX_CONCURRENT=4

# 2026-11-10 answer latency controls (host-owned; clients cannot change them).
# Answer generation reserve, evidence sources, thinking mode and repair.
AI_ANSWER_OUTPUT_TOKENS=3072
AI_ANSWER_SOURCE_LIMIT=4
AI_ANSWER_NO_THINKING=0
AI_PLANNER_NO_THINKING=1
AI_ANSWER_REPAIR=1
# 0 = publish the model-synthesized answer after claims/citations pass (recommended);
# 1 = also semantic-review the whole prose and fall back when it fails.
AI_PROSE_REVIEW=0
AI_ANSWER_REPAIR_TOKENS=1024
# Unverified draft preview in the browser; final done.answer stays authoritative.
AI_DRAFT_STREAMING=1
# Review already-emitted claims while the answer is still streaming.
AI_EARLY_REVIEW=1
AI_EARLY_REVIEW_FAILFAST=1
AI_REVIEW_SHARDS=2
AI_REVIEW_SHARD_MIN_CLAIMS=4
# API slot wait queue: 0 restores the old fail-fast API_BUSY behavior.
AI_API_QUEUE_TIMEOUT_SECONDS=12
# Evidence-versioned local answer cache; 0 disables it.
AI_ANSWER_CACHE_TTL_SECONDS=86400

# Agent P0: server-owned limits per HTTP request or background job.
# Output reservations are conservative and are not refunded on unknown usage.
AI_MAX_OUTPUT_TOKENS=4096
AI_RUN_MAX_MODEL_CALLS=16
# One separate source-free MiMo answer after a RAG failure; never replay its request.
AI_RAG_GENERAL_FALLBACK=1
AI_RUN_MAX_TOOL_CALLS=12
AI_RUN_MAX_OUTPUT_TOKENS=32768
AI_RUN_TIMEOUT_SECONDS=300
# 0 disables the monetary limit; counts/tokens/time still apply.
# Set both prices to your configured text model's actual CNY / million tokens.
# With a monetary limit, unpriced image/audio/OCR/embedding/rerank calls are blocked.
AI_RUN_BUDGET_CNY=0
AI_INPUT_CNY_PER_MILLION=0
AI_OUTPUT_CNY_PER_MILLION=0

# P1: text learning requests can plan and choose only host-approved read tools.
# 0 restores the previous fixed workflow; clients cannot change these limits.
AI_AGENT_PLANNING_ENABLED=1
AI_AGENT_MAX_ROUNDS=8
AI_AGENT_MAX_REPLANS=2
AI_AGENT_NO_PROGRESS_LIMIT=2
AI_AGENT_DECISION_TOKENS=1536

# Empty embedding key can use a separately provisioned local .env.team-embedding.
# The repository includes a template only; no real API key is distributed by Git.
# Set XUEYA_SHARED_EMBEDDING=0 to disable that fallback and use only local settings.
XUEYA_SHARED_EMBEDDING=1
# Other external RAG services remain optional and are configured locally.
# Embedding dimension must match the selected provider model.
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_PROVIDER=moark-qwen
RAG_EMBEDDING_MODEL=Qwen3-VL-Embedding-2B
RAG_EMBEDDING_BASE_URL=https://api.moark.com/v1
RAG_EMBEDDING_DIMENSION=2048
RAG_EMBEDDING_REVISION=1
# Auto-install the shipped stack/queue Markdown and its existing vectors (offline).
XUEYA_AUTO_IMPORT_STACK=1
RAG_RERANK_API_KEY=
RAG_RERANK_MODEL=
RAG_RERANK_BASE_URL=https://api.jina.ai/v1
RAG_OCR_API_KEY=
RAG_OCR_PROVIDER=mistral
RAG_OCR_MODEL=
RAG_OCR_BASE_URL=https://api.mistral.ai/v1
# Durable interactive Agent rollout (existing chat remains available).
AI_AGENT_DURABLE_ENABLED=1
AI_AGENT_INTERACTIVE_ENABLED=1
AI_AGENT_ROLLOUT_PERCENT=100
