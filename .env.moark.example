# Append these settings to the existing .env; preserve working chat settings.
# Never overwrite an existing .env, commit it, or paste keys in chat.
# Confirm actual model identifiers in the platform's API panel first.
RAG_OCR_PROVIDER=moark-mineru
RAG_OCR_API_KEY=
RAG_OCR_BASE_URL=https://api.moark.com/v1
RAG_OCR_MODEL=MinerU2.5-Pro
RAG_OCR_REVISION=1
RAG_OCR_TIMEOUT_SECONDS=60
RAG_EMBEDDING_PROVIDER=moark-qwen
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_BASE_URL=https://api.moark.com/v1
RAG_EMBEDDING_MODEL=Qwen3-VL-Embedding-2B
RAG_EMBEDDING_DIMENSION=2048
RAG_EMBEDDING_REVISION=1
# For 8B, change model AND dimension (4096), then explicitly rebuild indexes.
